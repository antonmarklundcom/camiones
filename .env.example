# ---------------------------------------------------------------------------
# camiones.com.py — environment variables
# Copy to .env for local dev. NEVER commit a real .env.
# tsx scripts do NOT auto-load .env — export DATABASE_URL in your shell first
# (PowerShell: $env:DATABASE_URL = "mysql://...").
# ---------------------------------------------------------------------------

# MySQL connection string. Local dev: `docker compose up -d` in this folder
# gives you mysql://camiones:camiones@localhost:3307/camiones. Production:
# Hostinger hPanel > Databases (enable Remote MySQL to run migrations locally).
DATABASE_URL=mysql://camiones:camiones@localhost:3307/camiones

# USD → PYG bootstrap rate. As of Batch 3 the real rate lives in the DB
# (`fx_rates`, editable at /admin/cotizacion) and USD is the primary price —
# price_gs is a derived cache recomputed whenever the rate changes. This env
# var is used ONLY while fx_rates is still empty (fresh install / seeds); once
# a rate row exists it is ignored, so don't try to change prices from here.
USD_TO_PYG=7300

# Secret for the guarded scheduled-jobs route (/api/cron) — see docs/cron.md.
# Minimum 16 chars; generate with:  openssl rand -base64 32
# UNSET = the route refuses everything with 503. That is the safe default.
CRON_SECRET=

# Feature flags (Decisions Log). Public (build-time inlined) so components can
# read them; flipping one needs a redeploy, which is what you want for a kill
# switch.
# financing: cuota calculator + card cuota line. DEFAULT OFF and it stays off
# until verified real rates replace the "(PLACEHOLDER)" financing programs.
# Turning it on with placeholder rates still renders nothing — src/lib/cuota.ts
# filters those out regardless.
NEXT_PUBLIC_FEATURE_FINANCING=0

# GoHighLevel inbound-webhook URL. Contact-form leads are POSTed here and are
# NOT stored in our DB. From GHL: Automations > Workflow > Inbound Webhook
# trigger. Leave empty in dev — leads are logged to the console instead.
GHL_WEBHOOK_URL=

# Cloudflare R2 (S3-compatible) — listing photos. From the Cloudflare
# dashboard: R2 > Manage R2 API Tokens (account id is in the R2 overview URL).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=camiones-images

# Public base URL for serving images: the bucket's public r2.dev URL or a
# custom domain (e.g. https://img.camiones.com.py). No trailing slash.
R2_PUBLIC_BASE_URL=

# Fallback WhatsApp number for CTAs when a seller has none. Digits only,
# with country code (595...). 595000000000 is a placeholder — replace with
# the real business number before launch.
NEXT_PUBLIC_DEFAULT_WHATSAPP=595000000000

# Canonical host — absolute URLs in metadata, sitemap and JSON-LD.
NEXT_PUBLIC_CANONICAL_HOST=camiones.com.py

# Admin/dealer session secret (iron-session cookie encryption). MUST be ≥32
# random chars in production — generate with:  openssl rand -base64 32
# In dev, an insecure fallback is used if this is unset; NEVER reuse it in prod.
SESSION_SECRET=
