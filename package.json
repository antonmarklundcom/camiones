{
  "name": "camiones",
  "version": "0.1.0",
  "private": true,
  "description": "camiones.com.py — Paraguay truck listings portal.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:brands": "tsx scripts/seed-brands.ts",
    "seed:locations": "tsx scripts/seed-locations.ts",
    "seed:financing": "tsx scripts/seed-financing.ts",
    "seed:listings": "tsx scripts/seed-sample-listings.ts",
    "seed:guides": "tsx scripts/seed-guides.ts",
    "seed:all": "npm run seed:brands && npm run seed:locations && npm run seed:financing && npm run seed:listings && npm run seed:guides",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "import:csv": "tsx scripts/import-csv.ts",
    "cron:cuotas": "tsx scripts/recompute-cuotas.ts",
    "cron:leads": "tsx scripts/retry-leads.ts",
    "content:guides": "tsx scripts/generate-guides.ts",
    "placeholders": "tsx scripts/generate-placeholders.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "iron-session": "^8.0.4",
    "marked": "^18.0.6",
    "mysql2": "^3.14.1",
    "next": "^15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.34.5",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "husky": "^9.1.7",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "^8.5.10"
  }
}
